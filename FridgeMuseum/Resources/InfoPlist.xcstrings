    "CFBundleName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Fridge Museum"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
