    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take photos of your kid’s drawings and crafts. Photos stay on this phone."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用相機拍下孩子的畫作和勞作。照片只會存在這支手機裡。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record your kid talking about their artwork. Recordings stay on this phone."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄下孩子介紹自己作品的聲音，錄音只會存在這支手機裡。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save finished artworks to Photos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把整理好的作品存到「照片」。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a My Fridge Museum album for each child and add finished artworks to it."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每位小朋友建立「冰箱美術館」相簿，並把整理好的作品放進去。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your kid’s recording into a text note on this phone. Nothing is uploaded."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手機上把孩子的錄音轉成文字備註，不會上傳到網路。"
          }
        }
      }
    }
  },
  "version" : "1.0"
