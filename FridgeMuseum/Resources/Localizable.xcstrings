    },
    "processing.note.paperNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t find the paper’s edges, so the whole photo is used. Fix it in “Crop.”"
