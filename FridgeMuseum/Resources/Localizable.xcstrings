    "processing.note.autoDroppedEdgeParts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other things at the edge were removed. Use “Tap What to Keep” to bring them back."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已自動去掉邊緣的其他東西，點一下可以加回來"
          }
        }
      }
    },
    "processing.note.cutoutFallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t separate the craft from the table, so the original photo is kept."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒能分開作品和桌面，先保留原照片"
          }
        }
      }
    },
    "processing.note.dotsKeptAsPattern" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lots of little dots look like part of the design, so they were left alone."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小點很多像是圖案，沒有清掉"
          }
        }
      }
    },
    "processing.note.notWhitePaper" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This isn’t white paper, so its original color is kept."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是白紙，保留紙本來的顏色"
