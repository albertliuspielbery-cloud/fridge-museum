<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync (1.2.0): CloudKit, the person's private database in this container. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.tw.starlight.fridgemuseum</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent CloudKit pushes tell the app another device changed something (development for Debug, production
	     for Release / App Store; APS_ENVIRONMENT in project.yml). -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- 主畫面小工具 (1.3.0): the app writes widget.json + small artwork images here for the widget extension
	     (App/WidgetSnapshot.swift). Group created by hand in the developer portal (HANDOFF.md「1.3.0 主畫面小工具」). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tw.starlight.fridgemuseum</string>
	</array>
</dict>
</plist>
