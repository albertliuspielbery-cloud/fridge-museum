<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync (1.2.0): CloudKit, the person's private database in this container. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.tw.starlight.fridgemuseum</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent CloudKit pushes tell the app another device changed something (development for Debug, production
	     for Release / App Store; APS_ENVIRONMENT in project.yml). -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
