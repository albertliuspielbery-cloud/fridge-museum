    "paywall.noPurchase" : {
      "comment" : "NOT YET REVIEWED. Restore found nothing.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 Apple 帳號沒有完整版的購買紀錄。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Full Version purchase was found for this Apple Account."
          }
        }
      }
    },
    "paywall.oneTime" : {
      "comment" : "Under the price on the ticket.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次買斷，不是訂閱，不會每月扣款"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time purchase — not a subscription. No recurring charges."
          }
        }
      }
    },
    "paywall.pending" : {
      "comment" : "NOT YET REVIEWED. Ask to Buy / pending purchase.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待同意（例如家長核准），完成後會自動解鎖。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for approval. The Full Version unlocks automatically once it’s approved."
          }
        }
      }
    },
    "paywall.perk1" : {
      "comment" : "Perk 1",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫作、勞作不限張數，想收多少就收多少"
