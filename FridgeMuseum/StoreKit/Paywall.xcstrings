        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Sharing: one purchase covers the whole family"
          }
        }
      }
    },
    "paywall.perk.flat %lld" : {
      "comment" : "Perk: unlimited drawings. %lld = free drawings per day (QuotaTracker.freeFlatPerDay).",
