{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "paywall.bibi" : {
      "comment" : "Bibi's speech bubble on the paywall.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了完整版，一整個抽屜的畫也能一次收完～"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the Full Version, a whole drawer of art can go up at once!"
          }
        }
      }
    },
    "paywall.close" : {
