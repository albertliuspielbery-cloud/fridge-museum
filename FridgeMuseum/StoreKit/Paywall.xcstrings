    "paywall.subtitle.craft %lld" : {
      "comment" : "Paywall subtitle (craft). %lld = free trial crafts.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費試用的 %lld 件勞作已經用完。解鎖完整版就能繼續收勞作，平面畫作每天仍有免費額度。"
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your free trial covered 1 craft. Unlock the Full Version for unlimited crafts. You still get free drawings every day."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your free trial covered %lld crafts. Unlock the Full Version for unlimited crafts. You still get free drawings every day."
                }
              }
            }
          }
        }
      }
    },
    "paywall.subtitle.flat %lld" : {
      "comment" : "Paywall subtitle (flat). %lld = free drawings per day.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這張作品還在。解鎖完整版就能馬上存下或收進來；也可以明天再收，每天都有 %lld 張免費。"
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This artwork is still here. Unlock the Full Version to save or hang it up now, or come back tomorrow for 1 more free drawing."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This artwork is still here. Unlock the Full Version to save or hang it up now, or come back tomorrow for %lld more free drawings."
                }
              }
            }
          }
        }
      }
    },
    "paywall.ticketKicker" : {
      "comment" : "Ticket stub kicker above the product name.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入場券"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ADMIT ONE"
