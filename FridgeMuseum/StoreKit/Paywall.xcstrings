    "paywall.noPurchase" : {
      "comment" : "NOT YET REVIEWED. Restore found nothing.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 Apple 帳號沒有完整版的購買紀錄。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Full Version purchase found for this Apple Account."
          }
        }
      }
    },
    "paywall.oneTime" : {
      "comment" : "Under the price on the ticket.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次買斷，不是訂閱，不會每月扣款"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time purchase — not a subscription. No recurring charges."
          }
        }
      }
    },
    "paywall.pending" : {
      "comment" : "NOT YET REVIEWED. Ask to Buy / pending purchase.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待同意（例如家長核准），完成後會自動解鎖。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for approval. It unlocks automatically once approved."
          }
        }
      }
    },
    "paywall.perk.craft %lld" : {
      "comment" : "Perk: unlimited crafts. %lld = lifetime free trial crafts (QuotaTracker.craftFreeTrial).",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立體勞作不限件數（免費版試用 %lld 件）"
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unlimited crafts (free trial: 1)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unlimited crafts (free trial: %lld)"
                }
              }
            }
          }
        }
      }
    },
    "paywall.perk.family" : {
      "comment" : "Perk: Family Sharing (the IAP has Family Sharing on; the app is iPhone-only).",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
