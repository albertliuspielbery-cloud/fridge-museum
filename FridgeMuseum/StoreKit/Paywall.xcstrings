        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ve used your free craft trial"
          }
        }
      }
    },
    "paywall.title.flat %lld" : {
      "comment" : "Paywall title (flat). %lld = free drawings per day.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的 %lld 張免費畫作收滿了"
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "That’s today’s free drawing"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "That’s all %lld free drawings for today"
                }
              }
            }
          }
        }
      }
    },
    "paywall.unlock %@" : {
      "comment" : "Primary button. %@ = StoreKit localized price.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖完整版 %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock Full Version · %@"
          }
        }
      }
