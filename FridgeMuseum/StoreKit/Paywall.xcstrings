{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "paywall.bibi" : {
      "comment" : "Bibi's speech bubble on the paywall.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢來～想多收幾張的時候，再來找我就好"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rush! Come find me whenever you want to hang up more."
          }
        }
      }
    },
    "paywall.close" : {
      "comment" : "Close button accessibility label.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        }
      }
    },
    "paywall.failed" : {
      "comment" : "NOT YET REVIEWED.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買沒有完成，請稍後再試。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase didn’t go through. Please try again later."
          }
        }
      }
    },
    "paywall.family" : {
      "comment" : "Family Sharing line (present tense: the IAP has Family Sharing on).",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全家共享：支援 Apple「家人共享」，家人的手機也能一起用。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works with Family Sharing, so family members can use it on their own devices."
          }
        }
      }
    },
    "paywall.later.craft" : {
      "comment" : "Secondary button (craft).",
