<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 主畫面小工具 (1.3.0): reads widget.json + the artwork images the app writes here (Shared/WidgetModel.swift).
	     The group is created by hand in the developer portal and enabled on both App IDs (HANDOFF.md「1.3.0 主畫面小工具」). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tw.starlight.fridgemuseum</string>
	</array>
</dict>
</plist>
