DEFINE SCHEMA

    RECORD TYPE CD_Artwork (
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE QUERYABLE,
        "CD_entityName"                 STRING,
        "CD_id"                         STRING,
        "CD_child"                      STRING,
        "CD_createdAt"                  TIMESTAMP,
        "CD_capturedAt"                 TIMESTAMP,
        "CD_title"                      STRING,
        "CD_title_ckAsset"              ASSET,
        "CD_note"                       STRING,
        "CD_note_ckAsset"               ASSET,
        "CD_kindRaw"                    STRING,
        "CD_recipeData"                 BYTES,
        "CD_recipeData_ckAsset"         ASSET,
        "CD_processingStateRaw"         STRING,
        "CD_renderVersion"              INT64,
        "CD_pixelWidth"                 INT64,
        "CD_pixelHeight"                INT64,
        "CD_tags"                       BYTES,
        "CD_tags_ckAsset"               ASSET,
        "CD_isFavorite"                 INT64,
        "CD_medium"                     STRING,
        "CD_isKept"                     INT64,
        "CD_keptAt"                     TIMESTAMP,
        "CD_isSample"                   INT64,
        "CD_originalImageData"          BYTES,
        "CD_originalImageData_ckAsset"  ASSET,
        "CD_renderedImageData"          BYTES,
        "CD_renderedImageData_ckAsset"  ASSET,
        "CD_thumbnailData"              BYTES,
        "CD_thumbnailData_ckAsset"      ASSET,
        "CD_fingerprintData"            BYTES,
        "CD_fingerprintData_ckAsset"    ASSET,
        "CD_voiceNoteData"              BYTES,
        "CD_voiceNoteData_ckAsset"      ASSET,
        "CD_voiceTranscript"            STRING,
        "CD_voiceTranscript_ckAsset"    ASSET,
        "CD_lastSavedToPhotosAt"        TIMESTAMP,
        "CD_originDeviceID"             STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Child (
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE QUERYABLE,
        "CD_entityName"                 STRING,
        "CD_id"                         STRING,
        "CD_name"                       STRING,
        "CD_birthday"                   TIMESTAMP,
        "CD_avatarColorHex"             STRING,
        "CD_avatarImageData"            BYTES,
        "CD_avatarImageData_ckAsset"    ASSET,
        "CD_createdAt"                  TIMESTAMP,
        "CD_originDeviceID"             STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE,
        roles                           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
